# Semuanya opsional. Semua nilai di bawah bisa diisi lewat dialog "LLM settings"
# di aplikasi, dan yang di sana selalu didahulukan daripada environment ini.

# Dipakai provider Gemini kalau tidak ada key yang diisi di LLM settings.
GEMINI_API_KEY=""

# Dipakai panel Assistant kalau tidak ada key yang diisi di LLM settings.
# Urutan pembacaannya: LLM settings -> ANTHROPIC_AUTH_TOKEN -> ANTHROPIC_API_KEY.
# Assistant memerlukan endpoint berformat Anthropic Messages (/v1/messages),
# bukan OpenAI-compatible seperti tiga langkah generate lainnya.
ANTHROPIC_AUTH_TOKEN=""
