{
  "name": "the-architech",
  "productName": "The Architech",
  "description": "A local-first AI workbench that turns a rough idea into an agent-ready task board.",
  "author": "Charis Chakim",
  "license": "MIT",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "tsx --watch --watch-path=./server.ts --watch-path=./db.ts --watch-path=./server server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs --production",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js release",
    "lint": "tsc --noEmit",
    "electron": "electron .",
    "dist": "npm run build && electron-builder",
    "dist:win": "npm run build && electron-builder --win",
    "dist:linux": "npm run build && electron-builder --linux"
  },
  "build": {
    "appId": "com.charischakim.thearchitech",
    "productName": "The Architech",
    "directories": {
      "output": "release",
      "buildResources": "build-resources"
    },
    "files": [
      "electron/**",
      "dist/**",
      "package.json",
      "node_modules/**/*",
      "!node_modules/@anthropic-ai/claude-agent-sdk-*/**"
    ],
    "asarUnpack": [
      "dist/**"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "CharisChakim",
        "repo": "the-architech"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "icon": "build-resources/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "TheArchitech-Setup-${version}-${arch}.${ext}"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": ["x64"]
        },
        {
          "target": "deb",
          "arch": ["x64"]
        }
      ],
      "icon": "build-resources/icon.png",
      "category": "Development",
      "maintainer": "Charis Chakim <charis@24slides.com>",
      "synopsis": "Turn a rough idea into an agent-ready task board",
      "artifactName": "TheArchitech-${version}-${arch}.${ext}"
    }
  },
  "//dependencies": "Runtime only. Everything the browser needs is bundled into dist/ by Vite, so client libraries belong in devDependencies — electron-builder ships `dependencies` verbatim into the installer.",
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.272",
    "dotenv": "^17.2.3",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@xyflow/react": "^12.11.2",
    "canvas-confetti": "^1.9.4",
    "lucide-react": "^0.546.0",
    "mermaid": "^11.16.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "@types/canvas-confetti": "^1.9.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@vitejs/plugin-react": "^5.0.4",
    "autoprefixer": "^10.4.21",
    "electron": "^44.4.3",
    "electron-builder": "^26.0.12",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
